# Get this token from @BotFather on Telegram (send /newbot)
BOT_TOKEN=put-your-botfather-token-here

# Your Telegram numeric user ID(s) that receive new leads.
# Comma-separated for multiple admins. Find yours via @userinfobot.
ADMIN_IDS=123456789

# Optional: defaults to a local SQLite file. Leave as-is to start.
# DB_URL=sqlite+aiosqlite:///partners.db

# Optional Google Sheets logging — pick ONE auth method (see README section C / C2).
# GOOGLE_SHEET_ID=the-long-id-from-your-sheet-url
#
# Method 1 — service account (README C). Takes priority if set.
# GOOGLE_CREDENTIALS_JSON={"type":"service_account",...}
#
# Method 2 — OAuth (README C2). Use when your org blocks service-account keys.
# Generate the refresh token once with: python get_google_refresh_token.py
# GOOGLE_OAUTH_CLIENT_ID=xxxx.apps.googleusercontent.com
# GOOGLE_OAUTH_CLIENT_SECRET=GOCSPX-xxxx
# GOOGLE_OAUTH_REFRESH_TOKEN=1//0gxxxx
